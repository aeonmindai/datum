{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["packages/**", "package.json", "package-lock.json", "Dockerfile"]
  },
  "deploy": {
    "startCommand": "node packages/datum/dist/cli/index.js serve",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "sleepApplication": false,
    "overlapSeconds": 20,
    "drainingSeconds": 10
  }
}
