# Datum — every variable the server reads. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# There are NO real values in this file and there never will be: this repo is public. Every
# line below is either a placeholder or a safe default.
#
# The server FAILS CLOSED. It refuses to boot without (a) an admin credential — either
# DATUM_ADMIN_PASSWORD_HASH or DATUM_ADMIN_PASSWORD — and (b) DATUM_SESSION_SECRET. There is
# no default password in the image, by design: a shipped default credential is a CVE, not a
# convenience.
#
# Generate both:
#   openssl rand -hex 32                       # DATUM_SESSION_SECRET
#   openssl rand -base64 18                    # a password, if you want one generated
#   npx @aeonmind/datum hash-password '...'    # DATUM_ADMIN_PASSWORD_HASH


# ---- REQUIRED ---------------------------------------------------------------------------

# REQUIRED. Postgres 13 or newer; `btree_gist` must be installable (it ships in contrib).
# docker compose supplies this for you. On Fly it is a secret pointing at the private 6PN
# address of the database app.
DATABASE_URL=postgres://datum:CHANGE_ME@localhost:5432/datum

# REQUIRED (min 32 chars). Signs the `datum_session` admin cookie. Rotating it logs every
# admin session out immediately, which is the point.
#   openssl rand -hex 32
DATUM_SESSION_SECRET=

# REQUIRED: set exactly one of the next two.
#
# Preferred. An argon2id hash — the server never holds the plaintext.
#   npx @aeonmind/datum hash-password 'your-password'
DATUM_ADMIN_PASSWORD_HASH=
#
# Fallback for one-click platforms that cannot run a hashing command before boot. The server
# hashes this at startup, keeps only the hash in memory, never persists the plaintext, and
# logs a warning telling you to switch. If the hash above is set, this is ignored.
DATUM_ADMIN_PASSWORD=


# ---- IDENTITY AND ADDRESSING ------------------------------------------------------------

# The scope root. DATUM_ORG=acme yields `org/acme`. Configuration, not code: nothing in the
# codebase assumes any particular value, and no query assumes this is the top of the tree.
# Must match [A-Za-z0-9_.-]+. Default: local
DATUM_ORG=local

# TCP port to listen on. Default: 8080
PORT=8080

# Interface to bind. Default: 0.0.0.0 (required inside a container)
HOST=0.0.0.0

# Absolute base URL this instance is reached at, no trailing slash. Used for absolute links
# and the OAuth protected-resource document. Default: http://localhost:$PORT
DATUM_PUBLIC_URL=http://localhost:8080


# ---- ADMIN SESSION AND LOGIN THROTTLE ---------------------------------------------------

# Admin session lifetime in seconds. Default: 43200 (12 hours)
DATUM_SESSION_TTL_SECONDS=43200

# Failed logins allowed per window before /admin/api/login answers 429. Default: 5
DATUM_LOGIN_ATTEMPTS=5

# Length of that window, in seconds. Default: 900 (15 minutes)
DATUM_LOGIN_WINDOW_SECONDS=900


# ---- VERIFICATION WORKER ----------------------------------------------------------------
# Confidence is earned: no agent may write `measured`. The worker promotes `unverified` to
# `measured` only after confirming that evidence.commit resolves and is contained where the
# assertion claims. With nothing configured below, rows simply stay `unverified` — that is a
# normal state, not an error, and no gate requiring `measured` will read them as satisfied.

# Local git clones the worker may consult, as `owner/repo=/path,owner/other=/path`. Bare or
# working clones both work. Checked before the network. Default: empty
DATUM_GIT_MIRRORS=

# Optional GitHub token, used ONLY when no local mirror answers for a repo. Needs read
# access to the repos named in evidence. api.github.com is the single outbound host this
# server ever contacts, and only if you set this. There is no telemetry to disable.
DATUM_GITHUB_TOKEN=

# How often the worker sweeps for unverified rows, in ms. Default: 15000
DATUM_VERIFY_INTERVAL_MS=15000

# Rows promoted per sweep. Default: 25
DATUM_VERIFY_BATCH_SIZE=25


# ---- ADMIN PANEL ASSETS -----------------------------------------------------------------

# Directory holding the built admin bundle. The published image sets this to
# /app/packages/datum/public/admin. Set it only if you are serving a bundle from elsewhere;
# leave empty and the server resolves it relative to its own dist. Default: empty
DATUM_ADMIN_DIST=


# ---- BACKUPS (scripts/backup.sh, scripts/restore-drill.sh) ------------------------------
# Read by the scripts, not by the server. The bucket MUST live outside the Fly organisation:
# a backup inside the blast radius is not a backup.

# S3-compatible bucket name. Tigris on Fly, Backblaze B2, R2, plain S3 — any of them.
DATUM_BACKUP_BUCKET=

# S3-compatible endpoint. Omit for AWS S3 proper.
#   Tigris:      https://fly.storage.tigris.dev
#   Backblaze:   https://s3.us-west-004.backblazeb2.com
DATUM_BACKUP_ENDPOINT=

# age recipient — the PUBLIC key the dump is encrypted to. A public key is not a secret, but
# no real one is committed here. Generate a keypair with `age-keygen -o datum-backup.key`;
# the public line it prints goes here, and the key file goes in a password manager.
DATUM_BACKUP_AGE_RECIPIENT=age1PLACEHOLDER_REPLACE_WITH_YOUR_OWN_PUBLIC_KEY

# Path to the age IDENTITY file. Needed ONLY to restore, and only by restore-drill.sh. Never
# put this on the machine that takes the backups: encrypt-only there is the whole point.
DATUM_BACKUP_AGE_IDENTITY=

# Objects older than this many days are pruned after a successful upload. Default: 30
DATUM_BACKUP_RETENTION_DAYS=30

# Fail the backup if the encrypted dump is smaller than this many bytes. A dump that
# suddenly shrinks is the classic silent-corruption signal. Default: 8192
DATUM_BACKUP_MIN_BYTES=8192

# S3 credentials, from your object-storage provider. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
